{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agrosar/humedad.v0",
  "title": "Serie de humedad del suelo por área (PROPUESTA v0)",
  "description": "Producido por el rol Datos. Un archivo por área en public/data/humedad/<id>.json. Un área puede ser una zona agrícola o un distrito de Itapúa.",
  "type": "object",
  "required": ["id", "zona", "bbox", "fuente", "es_ejemplo", "serie"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "zona": { "type": "string", "description": "Nombre visible del área" },
    "tipo": { "enum": ["zona", "distrito", "departamento"], "default": "zona" },
    "bbox": {
      "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4,
      "description": "[lon_min, lat_min, lon_max, lat_max] WGS84"
    },
    "fuente": { "type": "string", "description": "p. ej. 'NISAR L3 SME2 provisional' o 'EJEMPLO FICTICIO'" },
    "es_ejemplo": { "type": "boolean" },
    "mascara": { "type": "string", "description": "Opcional: qué píxeles se promediaron (p. ej. 'solo agrícola: <fuente>')" },
    "serie": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fecha", "humedad_m3m3", "calidad"],
        "properties": {
          "fecha": { "type": "string", "format": "date" },
          "humedad_m3m3": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "hv_db": { "type": ["number", "null"], "description": "Retrodispersión HV media (GCOV), opcional" },
          "calidad": { "enum": ["buena", "dudosa", "sin_dato"] },
          "pixeles_validos": { "type": "integer", "description": "Opcional" }
        }
      }
    }
  }
}
